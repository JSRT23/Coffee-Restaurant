# Copia este archivo como .env (no se sube a GitHub).

SECRET_KEY=cambia-esto-por-una-clave-larga-y-aleatoria
DEBUG=True

# Hosts extra permitidos (separados por coma). localhost y 127.0.0.1 ya vienen incluidos.
ALLOWED_HOSTS=
# Orígenes extra permitidos por CORS (el frontend Krazz-Ice en local es http://localhost:5173).
CORS_ALLOWED_ORIGINS=http://localhost:5173

# Base de datos. Sin definirla se usa SQLite. Ejemplos:
#   postgres://usuario:clave@host:5432/basededatos
#   mysql://usuario:clave@host:3306/basededatos
# DATABASE_URL=

# Correo (Gmail con contraseña de aplicación) para avisos a los clientes
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
